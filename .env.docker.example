# App
NEXTAUTH_URL=https://openreply.spikeiq.cloud
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
CRON_SECRET=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-64-hex-chars-openssl-rand-hex-32

# Docker Compose overrides DATABASE_URL / REDIS_URL in containers.
DATABASE_URL=postgresql://openreply:CHANGE_ME@postgres:5432/openreply
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=CHANGE_ME

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
